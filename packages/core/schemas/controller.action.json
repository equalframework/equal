{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:equal:json-schema:core:controller.action",
  "title": "eQual Controller Action Definition",
  "description": "Schema for eQual action controller structure (data action PHP files converted to JSON)",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Human-readable description of the action"
    },
    "deprecated": {
      "type": "boolean",
      "description": "Indicates if the action is deprecated"
    },
    "help": {
      "type": "string",
      "description": "Extended help text for the action"
    },
    "params": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Data type of the parameter (e.g. string, integer, boolean)"
              },
              "usage": {
                "type": "string",
                "description": "Additional format or semantic usage applied to the parameter type"
              },
              "foreign_object": {
                "type": "string",
                "description": "Fully qualified entity name targeted by a relational parameter"
              },
              "description": {
                "type": "string",
                "description": "Description of the parameter for documentation purposes"
              },
              "help": {
                "type": "string",
                "description": "Extended usage information for the parameter"
              },
              "selection": {
                "oneOf": [
                  {"type": "array"},
                  {"type": "object"}
                ],
                "description": "Optional list/map of allowed values for the parameter"
              },
              "domain": {
                "type": "array",
                "description": "Domain expression restricting values available to the parameter"
              },
              "min": {
                "type": "number",
                "description": "Minimum accepted value or cardinality"
              },
              "max": {
                "type": "number",
                "description": "Maximum accepted value or cardinality"
              },
              "pattern": {
                "type": "string",
                "description": "Regular expression that accepted values must match"
              },
              "in": {
                "type": "array",
                "description": "Explicit list of accepted values"
              },
              "required": {
                "type": "boolean",
                "description": "Indicates if the parameter is required"
              },
              "visible": {
                "oneOf": [
                  {"type": "boolean"},
                  {"type": "array"}
                ],
                "description": "Visibility flag or domain expression controlling parameter relevance"
              },
              "default": {
                "description": "Default value for the parameter if not provided"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "type": "array",
          "maxItems": 0
        }
      ]
    },
    "response": {
      "type": "object",
      "properties": {
        "content-type": {
          "type": "string",
          "examples": ["application/json", "text/plain", "text/html"],
          "description": "Response MIME type"
        },
        "charset": {
          "type": "string",
          "default": "utf-8"
        },
        "accept-origin": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {"type": "string"}
            }
          ],
          "description": "CORS origin policy"
        }
      },
      "description": "Response configuration"
    },
    "access": {
      "type": "object",
      "properties": {
        "visibility": {
          "type": "string",
          "description": "Access visibility level"
        },
        "groups": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Required groups for access"
        },
        "users": {
          "type": "array",
          "items": {"type": "integer"},
          "description": "Required users for access"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "Minimum effective authentication level required for access"
        },
        "auth_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "Deprecated alias for the minimum effective authentication level"
        }
      },
      "description": "Access control rules"
    },
    "providers": {
      "type": "array",
      "items": {"type": "string"},
      "examples": ["context", "orm", "auth", "user"],
      "description": "Required service providers"
    },
    "constants": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Required constant definitions for overriding"
    },
    "examples": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Action categorization examples for documentation"
    },
    "extends": {
      "type": "string",
      "minLength": 1,
      "description": "Controller identifier whose announced parameters are inherited before local parameter definitions are applied.",
      "examples": ["core_model_update"]
    }
  },
  "additionalProperties": false
}
